{
  "permissions": {
    "deny": [
      "Read(~/.aws/credentials)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.terraformrc)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-infra.sh"
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "dark-ansi"
}
